---
interface Props {
  /** Diagonal arrow for links that leave the site. */
  external?: boolean;
  /** Downward arrow for file downloads. */
  download?: boolean;
}

const { external = false, download = false } = Astro.props;

const path = download
  ? 'M8 1.5v9.5M3.5 6.5 8 11l4.5-4.5M2.5 14.5h11'
  : external
    ? 'M4.5 11.5 11.5 4.5M5.5 4.5h6v6'
    : 'M1.5 8h12.5M9.5 3.5 14 8l-4.5 4.5';
---

<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <path d={path} stroke="currentColor" stroke-width="1.5"></path>
</svg>
