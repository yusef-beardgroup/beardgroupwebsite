---
const partners = ['LexisNexis', 'Westlaw', 'Bloomberg Professional', 'Factiva', 'Refinitiv', 'AlphaSense'];
---

<section class="partners" aria-labelledby="partners-heading">
  <div class="container partners__inner">
    <h2 id="partners-heading">Our news and research is available via</h2>
    <ul>
      {partners.map((partner) => <li>{partner}</li>)}
    </ul>
  </div>
</section>

<style>
  .partners {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--gray-200);
    background: var(--gray-50);
  }

  .partners__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 3rem;
  }

  h2 {
    color: var(--gray-500);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.4;
    letter-spacing: normal;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    color: var(--gray-700);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }
</style>
