---
import Arrow from './Arrow.astro';

interface Props {
  title: string;
  /**
   * The whole card links here. Absolute URLs open in a new tab; site paths
   * should be built with url().
   */
  href: string;
  /** Short label above the title, such as publishing frequency. */
  meta?: string;
  linkLabel?: string;
  /** Small text opposite the link; defaults to the domain for external links. */
  detail?: string;
  /** Mark the link as a file download. */
  download?: boolean;
  headingLevel?: 'h2' | 'h3';
  size?: 'default' | 'large';
}

const {
  title,
  href,
  meta,
  linkLabel = 'Learn More',
  detail,
  download = false,
  headingLevel: Heading = 'h3',
  size = 'default',
} = Astro.props;

const external = /^https?:\/\//.test(href);
const footerDetail = detail ?? (external ? new URL(href).hostname.replace(/^www\./, '') : undefined);
const icon = download ? 'download' : external ? 'external' : 'next';
---

<article class:list={['card', { 'card--large': size === 'large' }]}>
  {meta && <p class="card__meta">{meta}</p>}
  <Heading class="card__title">{title}</Heading>
  <div class="card__body">
    <slot />
  </div>
  <footer class="card__footer">
    <a
      class="card__link"
      href={href}
      data-icon={icon}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
      download={download || undefined}
    >
      {linkLabel}
      <span class="visually-hidden">: {title}{external && ', opens in a new tab'}</span>
      <Arrow external={icon === 'external'} download={download} />
    </a>
    {footerDetail && <span class="card__detail">{footerDetail}</span>}
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid var(--gray-200);
    background: var(--white);
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .card--large {
    gap: 1rem;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 3px;
    background: var(--navy);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .card:hover {
    border-color: var(--gray-500);
    box-shadow: 0 20px 40px -28px rgb(11 31 58 / 0.45);
    transform: translateY(-3px);
  }

  .card:hover::before,
  .card:focus-within::before {
    transform: scaleX(1);
  }

  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--navy);
    outline-offset: 3px;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card__meta::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .card__title {
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .card--large .card__title {
    font-size: var(--text-2xl);
  }

  .card__body {
    margin-bottom: 1rem;
    color: var(--gray-700);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card--large .card__body {
    font-size: var(--text-base);
  }

  .card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-200);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* Stretch the link over the whole card. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link :global(svg) {
    transition: transform 0.25s var(--ease-out);
  }

  .card:hover .card__link[data-icon='next'] :global(svg) {
    transform: translateX(4px);
  }

  .card:hover .card__link[data-icon='external'] :global(svg) {
    transform: translate(2px, -2px);
  }

  .card:hover .card__link[data-icon='download'] :global(svg) {
    transform: translateY(2px);
  }

  .card__detail {
    color: var(--gray-500);
    font-size: 0.8rem;
  }
</style>
